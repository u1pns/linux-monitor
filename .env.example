# Email Configuration for Server Alerts
# This file should be copied to a new file named .env and the values should be filled in.

# SMTP Server Host (e.g., smtp.gmail.com)
SMTP_HOST=smtp.serviciodecorreo.es

# SMTP Server Port (e.g., 465 for SSL, 587 for TLS)
SMTP_PORT=465

# Use true for SSL (port 465), false for TLS (port 587)
SMTP_SECURE=true

# Email account username
SMTP_USER=support@pixelsolution.es

# Email account password
SMTP_PASS=Support2025!

# The "From" address for the emails
# It's recommended to use the same address as SMTP_USER
MAIL_FROM=support@pixelsolution.es

# The recipient's email address
MAIL_TO=info@pixelsolution.es
